# --- General ---
APP_NAME="AI Equity Trader"
ENVIRONMENT=development
DEBUG=true

# --- Safety ---
# This system supports PAPER trading only. Do not set this to anything else;
# a live-trading mode does not exist yet and must never be enabled via config alone.
TRADING_MODE=paper
EMERGENCY_STOP=false

# --- Database ---
DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/ai_equity_trader

# --- API ---
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Market data ---
# "yahoo" (Yahoo Finance via the yfinance library) is the only provider implemented.
# It requires no API key or account. Real data only — there is no mock/fallback provider.
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_SYMBOLS=["RELIANCE","TCS","INFY","HDFCBANK","ICICIBANK"]
MARKET_DATA_TIMEFRAME=1d
# Hours before the latest fetched bar is considered stale (blocks new trades).
MARKET_DATA_MAX_STALENESS_HOURS=96
HISTORICAL_LOOKBACK_DAYS=180
HISTORICAL_CACHE_TTL_MINUTES=15

# --- Strategy: SMA crossover ---
SMA_SHORT_WINDOW=10
SMA_LONG_WINDOW=30

# --- Risk engine ---
STARTING_CAPITAL=1000000
RISK_MAX_POSITION_PCT=0.10
RISK_MAX_SIMULTANEOUS_POSITIONS=5
RISK_MAX_TRADES_PER_DAY=10
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_TRANSACTION_COST_BPS=5.0

# --- Autonomous scheduler ---
TRADING_CYCLE_INTERVAL_SECONDS=300
POSITION_MONITOR_INTERVAL_SECONDS=60
# Seeds the initial state on first run only. Autonomous trading stays STOPPED
# by default — an explicit POST /api/v1/trading/autonomous/start is required.
AUTONOMOUS_TRADING_ENABLED=false

# --- Indian market session (Asia/Kolkata; independent of the host's system timezone) ---
MARKET_TIMEZONE=Asia/Kolkata
MARKET_SESSION_START=09:15
MARKET_SESSION_END=15:30
# JSON list of ISO dates the market is closed, e.g. ["2026-01-26","2026-08-15"]
MARKET_HOLIDAYS=[]

# --- Exit management (configurable risk controls, not a claim of profitability) ---
STOP_LOSS_PERCENT=2
TARGET_PERCENT=4
TRAILING_STOP_ENABLED=false
TRAILING_STOP_PERCENT=1
FORCE_CLOSE_AT_SESSION_END=false

# --- Phase 5: Intraday (separate from the daily SMA(10/30) autonomous trader) ---
INTRADAY_SYMBOLS=["RELIANCE","TCS","INFY","HDFCBANK","ICICIBANK"]
INTRADAY_TIMEFRAME=5m
# Yahoo Finance hard limit for 5m/15m data: "must be within the last 60 days".
INTRADAY_MAX_LOOKBACK_DAYS=60
INTRADAY_MAX_STALENESS_MINUTES=30

# Intraday strategy: VWAP + EMA trend + RSI momentum + volume confirmation
INTRADAY_TREND_FAST_EMA=9
INTRADAY_TREND_SLOW_EMA=21
INTRADAY_RSI_PERIOD=14
INTRADAY_RSI_MIN=50
INTRADAY_RSI_MAX=75
INTRADAY_VOLUME_AVG_WINDOW=20
INTRADAY_VOLUME_MULTIPLIER=1.2

# Intraday risk engine (extends, never bypasses, the shared RiskEngine)
INTRADAY_STARTING_CAPITAL=100000
INTRADAY_RISK_MAX_TRADES_PER_DAY=5
INTRADAY_RISK_MAX_SIMULTANEOUS_POSITIONS=1
INTRADAY_RISK_MAX_CAPITAL_PER_TRADE_PCT=0.50
INTRADAY_RISK_MAX_DAILY_LOSS_PCT=0.02
INTRADAY_RISK_MAX_CONSECUTIVE_LOSSES=3
INTRADAY_RISK_COOLDOWN_MINUTES=15
INTRADAY_NO_ENTRY_MINUTES_BEFORE_CLOSE=15

# Intraday exit management
INTRADAY_STOP_LOSS_PERCENT=1.0
INTRADAY_TARGET_PERCENT=1.5
INTRADAY_TRAILING_STOP_ENABLED=false
INTRADAY_TRAILING_STOP_PERCENT=0.5
INTRADAY_MAX_HOLDING_MINUTES=120
INTRADAY_FORCE_CLOSE_AT_SESSION_END=true

# Intraday transaction costs + slippage
INTRADAY_TRANSACTION_COST_PERCENT=0.05
INTRADAY_SLIPPAGE_PERCENT=0.05

# Intraday autonomous scheduler — stays STOPPED by default; an explicit
# POST /api/v1/intraday/autonomous/start is required, same as the daily one.
INTRADAY_CYCLE_INTERVAL_SECONDS=60
INTRADAY_POSITION_MONITOR_INTERVAL_SECONDS=30
INTRADAY_AUTONOMOUS_TRADING_ENABLED=false

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
